# Public canonical origin (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_TELEMETRY_DISABLED=1

# Required for /admin. Use npm run setup:local to generate local values.
# Never expose either variable with a NEXT_PUBLIC_ prefix.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Required on Vercel; optional for local development. Set the URL and one private key.
# SUPABASE_SECRET_KEY is provided by the Vercel Supabase Marketplace integration.
# The legacy service-role key remains supported. Never prefix either key with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Explicitly enable passwordless sign-in only after configuring Auth
# Site URL and allowed redirects. Marketplace database keys alone do not enable accounts.
NEXT_PUBLIC_ACCOUNTS_ENABLED=false
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Billing stays disabled (Pro shows a waitlist) until all three are set.
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=

# Operator details for legal pages. Unset values render as visible placeholders.
NEXT_PUBLIC_LEGAL_COMPANY_NAME=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_PRIVACY_EMAIL=
NEXT_PUBLIC_LEGAL_JURISDICTION=

# Optional persistent data directory for a self-hosted local-file deployment.
# AI_COMPARE_DATA_DIR=C:\persistent-storage\ai-compare
